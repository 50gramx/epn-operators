apiVersion: serving.kserve.io/v1beta1
kind: InferenceService
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    epn.io/component: voice-llm
  annotations:
    # SCALE TO ZERO AT REST, WAKE ON THE FIRST REQUEST. The daemon's
    # packIdle/wakeBudget dance becomes these lines (D69).
    autoscaling.knative.dev/min-scale: "0"
    # BORN BY THE FIRST REQUEST, NOT TO PROVE ITSELF. Without this Knative
    # schedules one pod at creation to mark the revision ready, and at rest
    # the guest has no 3 GiB for it (the general engine holds that room
    # until a call yields it): "0/1 nodes are available: Insufficient
    # memory", founder's laptop 2026-09-21. The substrate enables
    # allow-zero-initial-scale for this line.
    autoscaling.knative.dev/initial-scale: "0"
    autoscaling.knative.dev/max-scale: "1"
    # Keep the pod for the learned re-dial window before it is scaled away.
    autoscaling.knative.dev/scale-to-zero-pod-retention-period: "{{ .RetainSeconds }}s"
    autoscaling.knative.dev/target: "1"
    autoscaling.knative.dev/metric: "concurrency"
spec:
  predictor:
    minReplicas: 0
    maxReplicas: 1
    timeout: 120
    priorityClassName: {{ .PriorityClass }}
    containers:
      - name: kserve-container
        image: {{ .Image }}
        imagePullPolicy: IfNotPresent
        ports:
          - containerPort: 11434
            protocol: TCP
        env:
          - name: OLLAMA_HOST
            value: "0.0.0.0:11434"
          - name: OLLAMA_KEEP_ALIVE
            value: "-1"
          - name: OLLAMA_MAX_LOADED_MODELS
            value: "1"
          - name: OLLAMA_NUM_PARALLEL
            value: "{{ .Parallel }}"
          - name: OLLAMA_CONTEXT_LENGTH
            value: "{{ .Context }}"
          - name: OLLAMA_MODELS
            value: "/models"
          - name: EPN_VOICE_MODEL
            value: "{{ .Model }}"
        # PRELOADED BEFORE READY. The talker's weights are faulted in by the
        # startup gate, so "ready" means "resident" and the call's first
        # turn is warm (the plan's "warm, not merely ready").
        startupProbe:
          exec:
            command: ["sh", "-c", "curl -sf http://127.0.0.1:11434/api/generate -d '{\"model\":\"{{ .Model }}\",\"keep_alive\":-1}' >/dev/null"]
          periodSeconds: 5
          failureThreshold: {{ .StartupFailures }}
        readinessProbe:
          httpGet:
            path: /api/tags
            port: 11434
          periodSeconds: 5
        resources:
          requests:
            cpu: "{{ .CPURequestMillicores }}m"
            memory: "{{ .MemoryMiB }}Mi"
          limits:
            cpu: "{{ .CPULimitMillicores }}m"
            memory: "{{ .MemoryMiB }}Mi"
        volumeMounts:
          - name: model-cache
            mountPath: /models
    volumes:
      - name: model-cache
        persistentVolumeClaim:
          claimName: {{ .PVCName }}
